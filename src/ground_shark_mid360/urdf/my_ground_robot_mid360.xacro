<?xml version="1.0" encoding="utf-8"?>
<!-- 地面麦轮小车 + Mid360 -->
<!-- 关节连接基于base_link——lidar_link——imu_link -->

<robot
    name="ground_shark_mid360" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- 1. 引入带有雷达模型的地面麦轮小车 -->
    <xacro:include
        filename="$(find ground_shark_mid360)/urdf/ground_shark_mid360_fixed.urdf" />

    <!-- 2. 引入雷达仿真宏并调用→ 自动生成 Gazebo 仿真传感器（关键！） -->
    <xacro:include filename="$(find ground_shark_mid360)/urdf/mid360_gazebo.xacro" />
    <xacro:Livox_Mid_gazebo_sensor
        name="lidar_link" 
        visualize="true"
        update_rate="10"
        ros_topic="/livox/lidar"
    />

    <!-- 设置属性变好看一点 -->
    <gazebo reference="wheel_fl_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="wheel_fr_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="wheel_bl_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="wheel_br_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="imu_link">
        <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="lidar_link">
        <material>Gazebo/Blue</material>
    </gazebo>

</robot>